    // nest 配置项（备选：单配置直接启动，不依赖手动起 start:debug）
    {
      "type": "node",
      "request": "launch",
      "name": "debug nest (launch)",
      "cwd": "${workspaceFolder}/nest-js-be",
      "runtimeExecutable": "npm",
      "args": [
        "run",
        "start:debug"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/nest-js-be/dist/**/*.js"]
    }
  ]
}